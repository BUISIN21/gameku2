# ConnectCall backend configuration — PLACEHOLDER VALUES ONLY.
# Copy to `.env` (git-ignored) and fill in real values locally, or set these as
# environment variables / Secret Manager secrets in production.

# Port the API listens on.
PORT=8080

# Public LiveKit WebSocket URL handed to clients (LiveKit Cloud: Project Settings).
# Local dev server: ws://localhost:7880 (Android device: ws://<laptop-LAN-IP>:7880)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key + secret. SERVER-SIDE ONLY. Never put these in the Flutter app.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Firebase project id (Firebase console → Project settings). Not a secret.
# The server authenticates to Firebase with Application Default Credentials:
#   locally:   gcloud auth application-default login
#   Cloud Run: the service's own service account (no key file needed)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local development without a Firebase project: run `npm run emulators` in
# another terminal, set FIREBASE_PROJECT_ID=demo-connectcall and uncomment:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Comma-separated list of browser origins allowed to call the API (CORS).
# Android apps are not browsers and are not affected by CORS.
CORS_ORIGINS=http://localhost:5000

# Lifetime of a LiveKit join token, in seconds. Tokens only need to live long
# enough to connect; LiveKit refreshes them automatically while connected.
TOKEN_TTL_SECONDS=600

# Number of reverse proxies in front of the API (Cloud Run / Render = 1).
# Required for correct client IPs in rate limiting. 0 when running locally.
TRUST_PROXY=0

# trace | debug | info | warn | error
LOG_LEVEL=info
